# Raw / large data — regenerate via scripts/load_data.py, don't version large binaries
data/*.zip
data/*.txt
data/*.parquet
data/incoming/
output/*.npy

# Model weight binaries -- big (100MB-900MB), regenerate by re-running the training
# scripts against a rented GPU (see WRITEUP.md §6.2). Small config/tokenizer/README
# files inside checkpoints/ ARE tracked (not excluded here) so the repo documents each
# run's exact hyperparameters/adapter config without the multi-hundred-MB weights.
checkpoints/**/*.safetensors
checkpoints/**/*.bin
checkpoints/**/*.gguf
checkpoints/**/training_args.bin
adapters/

# Raw intermediate Batch API payloads (~30MB of request/response JSON chunks) --
# regenerate via scripts/run_batch_cascade_labeling.py; the summarized results in
# data/*.parquet + output/*summary*.json are what actually matters for reproducibility.
output/batch_chunks/

# Editor/tool scratch, not part of the project
.specstory/
*.code-workspace

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/

# Env / secrets
.env
*.key
gcp-key*.json
